{
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "web/api/index.py",
      "use": "@vercel/python"
    }
  ],
  "functions": {
    "web/api/index.py": {
      "includeFiles": "src/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/web/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/web/$1"
    }
  ]
}
